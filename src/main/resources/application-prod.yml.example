# 운영 프로필 템플릿. 실제 application-prod.yml 은 .gitignore 처리되어 있다.
#   실행: java -jar app.jar --spring.profiles.active=prod
# 모든 시크릿은 환경변수로 주입한다.

spring:
  datasource:
    url: ${MYSQL_DATABASE}
    username: ${MYSQL_USERNAME}
    password: ${MYSQL_PASSWORD}
  jpa:
    hibernate:
      ddl-auto: validate      # 스키마는 Flyway 가 소유. 절대 update/create 금지
    properties:
      hibernate:
        format_sql: false
  flyway:
    enabled: true
  data:
    redis:
      host: ${REDIS_HOST}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD}
  jwt:
    secret: ${JWT_SECRET_KEY}
  mail:
    username: ${SPRING_MAIL_USERNAME}
    password: ${SPRING_MAIL_PASSWORD}

server:
  url: ${SERVER_URL}

# SQL 디버그 로그는 운영에서 켜지 않는다 (파라미터 바인딩 값 노출).
logging:
  level:
    root: INFO
    org.hibernate.SQL: warn

# 관측 엔드포인트는 별도 포트로 분리해 외부에 노출하지 않는다.
management:
  server:
    port: 9090
  endpoints:
    web:
      exposure:
        include: health,info,prometheus
  endpoint:
    health:
      show-details: never

gemini:
  api-key: ${GEMINI_API_KEY}
  model: gemini-2.5-flash

ai-service:
  url: ${AI_SERVICE_URL}

newspin:
  seed:
    enabled: false            # 운영에서는 절대 시드 적재 안 함
  cors:
    allowed-origins: ${NEWSPIN_CORS_ORIGINS}   # 예: https://newspin.app,https://www.newspin.app
