# 개인 로컬 오버라이드 템플릿.
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
# application-local.yml 은 .gitignore 처리되어 있다.
# 컨테이너로 개발한다면 이 파일 대신 `--spring.profiles.active=dev` 를 쓰는 편이 간단하다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3307/newspin?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: newspin
    password: newspin
  data:
    redis:
      host: localhost
      port: 6380
      password:
  jwt:
    secret: <base64-encoded 32+ byte secret>
  # docker-compose 의 Mailpit(가짜 SMTP, localhost:1025)을 그대로 써도 된다 — 그러면
  # 이 블록은 dev 프로필과 동일하게 auth/starttls 를 꺼야 한다. 실제 계정을 쓰려면
  # host/port 를 그 공급자 값으로, auth/starttls 는 true 로 채운다.
  mail:
    host: <smtp host>
    port: <smtp port>
    username: <smtp user>
    password: <smtp password>

server:
  url: http://localhost:8080

gemini:
  api-key: <google ai studio key>

ai-service:
  url: http://localhost:8000

newspin:
  seed:
    enabled: true
