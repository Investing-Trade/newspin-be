# 개인 로컬 오버라이드 템플릿.
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
# application-local.yml 은 .gitignore 처리되어 있다.
# 컨테이너로 개발한다면 이 파일 대신 `--spring.profiles.active=dev` 를 쓰는 편이 간단하다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3307/newspin?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: newspin
    password: newspin
  data:
    redis:
      host: localhost
      port: 6380
      password:
  jwt:
    secret: <base64-encoded 32+ byte secret>
  mail:
    username: <smtp user>
    password: <smtp password>

server:
  url: http://localhost:8080

gemini:
  api-key: <google ai studio key>

ai-service:
  url: http://localhost:8000

newspin:
  seed:
    enabled: true
